# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=agila
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agila
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
AGILA_API_KEY=
# Discord bot (block o): the bot token, the user IDs that get answers (comma-separated; blank = nobody), the server ID
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_GUILD_ID=
# Workflow A (block t): true sends Discord saves through n8n; the key matches n8n's Header Auth credential
SAVE_VIA_N8N=false
AGILA_N8N_SAVE_KEY=
